# Copy to discovery_mvp/.env. Do not commit credentials.
# Default Codex search, planning and ranking use ChatGPT sign-in; no API keys required.
# CODEX_CLI_PATH=C:/path/to/codex.exe
CODEX_SEARCH_TIMEOUT=240
CODEX_RANK_TIMEOUT=180
# Optional: override the CLI default model for planning/ranking.
# CODEX_RANK_MODEL=your-codex-model
# Increment if replacing a local model under the same model tag.
DISCOVERY_RANK_CACHE_VERSION=1
# Optional parent directory for the live/demo SQLite databases.
# Default on Windows: %LOCALAPPDATA%/TenderAgent/<workspace>/
# TENDER_AGENT_DB_DIR=C:/your/local/data/directory
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4.1-mini
# Optional: only used when explicitly selecting Ollama.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b-q4_K_M
